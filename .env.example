# Copy this file to .env and fill in your values
# GOOGLE_CREDENTIALS_PATH is optional — overrides paths.credentials in config.yaml
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# API keys — only the key for your chosen --provider is required
OLLAMA_API_KEY=your_ollama_api_key_here      # --provider cloud  (Ollama Cloud)
OPENAI_API_KEY=your_openai_api_key_here      # --provider openai
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # --provider anthropic
GEMINI_API_KEY=your_gemini_api_key_here      # --provider gemini
# No key needed for --provider local (default, uses local Ollama)
TAVILY_API_KEY=your_tavily_api_key_here   # agent search mode
HINDSIGHT_BASE_URL=http://localhost:8888  # optional: set if running a Hindsight server
